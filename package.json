{
  "name": "smartexam-ai---your-personal-tutor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "dev:web": "cd packages/web && npm run dev",
    "dev:electron": "cd packages/desktop && npm run electron-dev",
    "build:web": "cd packages/web && npm run build",
    "build:electron": "cd packages/desktop && npm run build",
    "test": "npm run test --workspace packages/core",
    "test:run": "npm run test:run --workspace packages/core",
    "test:ui": "cd packages/web && npm run test:ui",
    "type-check": "npm run type-check --workspace packages/core && npm run type-check --workspace packages/web && npm run type-check --workspace packages/desktop",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf packages/*/dist packages/*/dist-electron node_modules/.vite",
    "install:all": "npm install && npm install --workspace packages/core --workspace packages/web --workspace packages/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
