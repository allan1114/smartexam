# ========================================
# Google Gemini API Configuration
# ========================================

# 📌 方式 1：直接 API 密鑰（開發模式）
# 獲取方式：https://ai.google.dev/
# ⚠️ 警告：不要將此密鑰提交到版本控制，會暴露給客戶端
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 📌 方式 2：後端代理（生產模式 - 推薦）
# 使用 `/api/proxy-gemini` 端點來保護 API 密鑰
# 設置為 'true' 以啟用代理模式
VITE_USE_GEMINI_PROXY=false

# 代理 URL（如果在自定義路徑上）
# VITE_GEMINI_PROXY_URL=/api/proxy-gemini

# ========================================
# Vercel 環境變數（生產部署）
# ========================================

# 🔐 服務器端 API 密鑰（僅用於後端代理）
# 在 Vercel 儀表板中設置，不要在此暴露
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# 部署路徑（Base Path）
# ========================================

# 🌐 應用的根路徑。決定打包後所有 asset URL 的前綴。
#   - GitHub Pages（專案站台 allan1114.github.io/smartexam/）：留空即可，預設 /smartexam/
#   - Vercel（網域根目錄）：必須設為 /
# vercel.json 的 buildCommand 已經幫你設定好（VITE_BASE_PATH=/），
# 一般毋須手動設定；若在 Vercel 儀表板覆寫了 Build Command，記得帶上它，
# 否則所有 asset 會 404。
# VITE_BASE_PATH=/
